import argparse
import os
from collections.abc import Sequence
from pathlib import Path

from openqa_client.client import OpenQA_Client

from lib.common.log import get_logger
from lib.worker import bootstrap, job, job_flow, sysext
from lib.worker.job_flow import JobFlowError
from lib.worker.test_layout import staged_casedir
from lib.worker.test_manifest import Flow, Manifest

log = get_logger(__name__)
repo_root = Path(__file__).resolve().parent


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser()
    commands = parser.add_subparsers(dest="command", required=True)

    commands.add_parser("clean-pool")

    command_parser = commands.add_parser("build-sysext")
    _add_project_dir(command_parser)

    command_parser = commands.add_parser("job")
    _add_project_dir(command_parser)
    _add_variables_argument(command_parser)
    job_mode = command_parser.add_mutually_exclusive_group()
    job_mode.add_argument("--live", type=Path, metavar="PATH")
    job_mode.add_argument("--upgrade", action="store_true")
    command_parser.add_argument("--hdd", type=Path, required=True)
    command_parser.add_argument("--sysext", type=Path, required=True)
    command_parser.add_argument("--build", required=True)
    command_parser.add_argument("--variant", required=True)
    command_parser.add_argument("--name", required=True)
    command_parser.add_argument("--flavor", required=True)
    command_parser.add_argument("--group")
    command_parser.add_argument("--after", type=int)

    for command in ("worker", "flow"):
        command_parser = commands.add_parser(command)
        command_parser.add_argument("flow")
        _add_project_dir(command_parser)
        _add_variables_argument(command_parser)
        _add_flavor_suffix_argument(command_parser)
        command_parser.add_argument(
            "--upgrade-from",
            type=Path,
            metavar="ISO",
            help="install this local ISO as the upgrade base",
        )
        command_parser.add_argument(
            "--upgrade-to",
            type=Path,
            metavar="MKOSI_OUTPUT",
            help="upgrade using artifacts in this mkosi.output directory",
        )

    return parser


def _add_project_dir(parser: argparse.ArgumentParser) -> None:
    parser.add_argument(
        "--project-dir",
        type=Path,
        default=Path.cwd(),
        metavar="DIR",
        help="project checkout containing openqa/ and mkosi.output/, defaulting to the current directory",
    )


def _add_variables_argument(parser: argparse.ArgumentParser) -> None:
    parser.add_argument(
        "--var",
        action="append",
        default=[],
        metavar="NAME=VALUE",
        help="set a variable declared by the selected flow, multiple can be supplied",
    )


def _add_flavor_suffix_argument(parser: argparse.ArgumentParser) -> None:
    parser.add_argument(
        "--flavor-suffix",
        default="",
        metavar="SUFFIX",
        help="append this suffix to every job flavor in the selected flow",
    )


def _load_environment() -> None:
    if os.environ.get("MOCK_MODE"):
        return

    environment = repo_root / ".env"

    if not environment.is_file():
        return

    for line in environment.read_text().splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue

        name, value = line.split("=", 1)
        os.environ.setdefault(name.strip(), value.strip())


def _log_artifact_url() -> None:
    image_url = os.environ.get("IMAGE_URL")
    if not image_url:
        return

    bucket_url = image_url.rsplit("/", 1)[0]
    bucket_url = bucket_url.replace(
        "s3.kde.org/",
        "s3.kde.org/index.html#",
        1,
    )
    log.message(
        "In case of failure, inspect and download the image and sysupdate "
        "tree at: %s",
        bucket_url,
    )


def _parse_vars(
    parser: argparse.ArgumentParser,
    arguments: Sequence[str],
) -> dict[str, str]:
    variables: dict[str, str] = {}

    for argument in arguments:
        name, separator, value = argument.partition("=")
        if not separator or not name:
            parser.error(f"Expected NAME=VALUE for --var, got {argument!r}")

        variables[name] = value

    return variables


def _run_worker(
    *,
    image_dir: Path,
    manifest: Manifest,
    flow: Flow,
    upgrade_from: Path | None,
    upgrade_to: Path | None,
    variables: dict[str, str],
    flavor_suffix: str,
) -> None:

    # The single-instance mock already starts its own worker.
    if os.environ.get("MOCK_MODE"):
        return

    worker = bootstrap.start_worker()
    try:
        job_flow.run_jobs(
            repo_root=repo_root,
            image_dir=image_dir,
            manifest=manifest,
            flow=flow,
            worker_class=bootstrap.get_worker_class(),
            upgrade_from=upgrade_from,
            upgrade_to=upgrade_to,
            variables=variables,
            flavor_suffix=flavor_suffix,
        )
    finally:
        worker.terminate()
        worker.wait()
        _log_artifact_url()


def main() -> None:
    parser = _parser()
    args = parser.parse_args()

    if args.command in {"worker", "flow"} and (
        (args.upgrade_from is None) != (args.upgrade_to is None)
    ):
        parser.error(
            "--upgrade-from and --upgrade-to must be specified together"
        )

    _load_environment()

    if args.command == "clean-pool":
        job.clean_pool()
        return

    # Load and parse the manifest once, here, and dependency-inject throughout.
    project_dir = args.project_dir.expanduser().resolve()
    test_root = project_dir / Path(
        os.environ.get("TEST_PROJECT_OPENQA_DIR") or "openqa"
    ).expanduser()
    image_dir = project_dir / Path(
        os.environ.get("TEST_PROJECT_OUTPUT_DIR") or "mkosi.output"
    ).expanduser()
    manifest = Manifest.load(test_root)

    if args.command == "build-sysext":
        sysext.build_sysext(repo_root=repo_root, manifest=manifest)
        return

    if args.command == "flow":
        job_flow.run_jobs(
            repo_root=repo_root,
            image_dir=image_dir,
            manifest=manifest,
            flow=manifest.flow(args.flow),
            upgrade_from=args.upgrade_from,
            upgrade_to=args.upgrade_to,
            variables=_parse_vars(parser, args.var),
            flavor_suffix=args.flavor_suffix,
        )
        return

    if args.command == "job":
        with staged_casedir(
            args.name,
            manifest,
            repo_root=repo_root,
        ) as staged:
            job_config = job.JobConfig(
                live=args.live,
                upgrade=args.upgrade,
                hdd=args.hdd,
                sysext=args.sysext,
                build=args.build,
                variant=args.variant,
                name=args.name,
                flavor=args.flavor,
                casedir=staged.path,
                distri=manifest.distri,
                group=args.group,
                after=args.after,
                variables=_parse_vars(parser, args.var),
            )

            running_job = job.Job(
                OpenQA_Client(
                    server=os.environ["OPENQA_HOST_ADDR"],
                    scheme=os.environ.get("OPENQA_SCHEME", "https"),
                ),
                job_config,
            )

            result = running_job.run()

        match result:
            case job.JobSuccess():
                pass
            case job.JobNonFatalFailure():
                raise SystemExit(2)
            case job.JobFatalFailure(reason=reason):
                log.critical("Job failed: %s", reason)
                raise SystemExit(1)

        return

    if args.command == "worker":
        _run_worker(
            image_dir=image_dir,
            manifest=manifest,
            flow=manifest.flow(args.flow),
            upgrade_from=args.upgrade_from,
            upgrade_to=args.upgrade_to,
            variables=_parse_vars(parser, args.var),
            flavor_suffix=args.flavor_suffix,
        )
        return

    raise AssertionError(f"Unhandled command {args.command!r}")


if __name__ == "__main__":
    try:
        main()
    except OSError as error:
        log.critical("Worker filesystem operation failed: %s", error)
        raise SystemExit(1)
    except (JobFlowError, job.InvalidJobError) as error:
        log.critical("Job flow failed: %s", error)
        raise SystemExit(1)
