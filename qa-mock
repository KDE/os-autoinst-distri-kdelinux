import subprocess
import sys
from pathlib import Path

_MOCK_SCRIPT = Path(__file__).resolve().parent / "mocks" / "mock.sh"


def _mock(options: list[str]) -> None:
    subprocess.run([_MOCK_SCRIPT, *options], check=True)


def _enter_mock() -> None:
    subprocess.run(
        ["podman", "exec", "-it", "openqa-single-instance", "bash"],
        check=True,
    )


def main() -> None:
    if len(sys.argv) > 1 and sys.argv[1] == "enter":
        _enter_mock()
    else:
        _mock(sys.argv[1:])


if __name__ == "__main__":
    main()
